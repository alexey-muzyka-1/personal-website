---
// Каркас всех страниц админки: шапка, навигация, общий язык оформления.
// Данные страницы забирают сами — здесь только рамка.
import '../styles/admin.css';
import { sections, sectionOf } from '../data/nav';

interface Props {
  title: string;
  page: 'funnel' | 'sources' | 'channel' | 'scenario' | 'people';
}
const { title, page } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const current = sectionOf(page);
// Второй ряд рисуется только там, где внутри раздела есть выбор. Ряд из
// одной вкладки — это не навигация, а повтор заголовка.
const inner = current.pages.length > 1 ? current.pages : [];
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} · воронка</title>
</head>
<body>
  <div class="wrap">
    <header class="top">
      <div class="line">
        <a class="brand" href={base}>Личная воронка</a>
        <span class="grow" data-stamp></span>
      </div>
      <nav class="sections">
        {sections.map((s) => (
          <a
            href={base + s.pages[0].path}
            aria-current={s.id === current.id ? 'page' : undefined}
          >
            {s.label}
            <span class="hint">{s.hint}</span>
          </a>
        ))}
      </nav>

      {inner.length > 0 && (
        <nav class="tabs">
          {inner.map((p) => (
            <a href={base + p.path} aria-current={p.id === page ? 'page' : undefined}>{p.label}</a>
          ))}
        </nav>
      )}
    </header>

    <slot />
  </div>

  <script>
    // Время съёмки в шапке. Ходит на тот же обзор, что и страницы, но
    // страница без данных не должна из-за этого падать.
    import { api } from '../lib/api.ts';
    api('overview')
      .then((d) => {
        const el = document.querySelector('[data-stamp]');
        if (!el) return;
        el.textContent = 'снято ' + d.now;
      })
      .catch(() => {});
  </script>
</body>
</html>
