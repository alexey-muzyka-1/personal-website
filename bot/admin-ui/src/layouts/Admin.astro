---
// Каркас всех страниц админки: шапка, навигация, общий язык оформления.
// Данные страницы забирают сами — здесь только рамка.
import '../styles/admin.css';

interface Props {
  title: string;
  page: 'funnel' | 'sources' | 'channel' | 'scenario' | 'people';
}
const { title, page } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Канал стоит после источников и до сообщений: сначала откуда пришли,
// потом где остались, и только потом что именно им говорил бот.
const tabs = [
  { id: 'funnel', href: base, label: 'Обзор' },
  { id: 'sources', href: base + 'sources/', label: 'Источники' },
  { id: 'channel', href: base + 'channel/', label: 'Канал' },
  { id: 'scenario', href: base + 'scenario/', label: 'Сообщения' },
  { id: 'people', href: base + 'people/', label: 'Люди' },
];
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} · воронка</title>
</head>
<body>
  <div class="wrap">
    <header class="top">
      <div class="line">
        <a class="brand" href={base}>Личная воронка</a>
        <span class="grow" data-stamp></span>
      </div>
      <nav class="tabs">
        {tabs.map((t) => (
          <a href={t.href} aria-current={t.id === page ? 'page' : undefined}>{t.label}</a>
        ))}
      </nav>
    </header>

    <slot />
  </div>

  <script>
    // Время съёмки в шапке. Ходит на тот же обзор, что и страницы, но
    // страница без данных не должна из-за этого падать.
    import { api } from '../lib/api.ts';
    api('overview')
      .then((d) => {
        const el = document.querySelector('[data-stamp]');
        if (!el) return;
        el.textContent = 'снято ' + d.now + (d.hidden ? ' · скрыт' + (d.hidden === 1 ? ' 1 тестовый аккаунт' : 'о ' + d.hidden + ' тестовых аккаунтов') : '');
      })
      .catch(() => {});
  </script>
</body>
</html>
