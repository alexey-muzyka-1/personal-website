---
import Admin from '../layouts/Admin.astro';
---

<Admin title="Источники" page="sources">
  <div class="bar" data-slice></div>

  <section class="card">
    <h2>Откуда приходят и что получают</h2>
    <p class="lede" style="margin:0 0 16px">
      Одна строка — одно место, откуда человек попадает в бота: где стоит ссылка,
      что он получает и почему именно это. Метка живёт независимо от трафика, поэтому
      молчащие остаются в списке — их важно видеть именно тогда, когда они молчат.
    </p>
    <div data-channels></div>
  </section>

  <section class="card">
    <h2>Что бот отдаёт</h2>
    <div data-materials></div>
  </section>

  <section class="card">
    <h2>Как завести метку под новый Reel</h2>
    <ol class="lede" style="max-width:68ch">
      <li>Придумать метку вида <code>reel_20260820_razbor_01</code>: латиница, цифры, <code>_</code> и <code>-</code>.</li>
      <li>Отдавать ссылку <code data-example>…?start=метка</code> в ответ на кодовое слово — руками или автоматизацией.</li>
      <li>Ничего не менять в боте: незнакомая метка сама появится в таблице выше и получит материал по умолчанию.</li>
      <li>Правка каталога нужна только если этот Reel должен вести на другой материал.</li>
    </ol>
    <p class="lede">
      Кодовое слово живёт на стороне Instagram. Бот его не видит и не должен: ему приходит
      только метка, по которой дальше считается вся воронка.
    </p>
  </section>
</Admin>

<script>
  import { api, fail, readSlice, href, el, share, sourceLabel, NO_VALUE } from '../lib/api.ts';
  import { renderSlice } from '../lib/slice.ts';

  const slice = readSlice();
  renderSlice(document.querySelector('[data-slice]'), 'sources', slice);

  const host = document.querySelector('[data-channels]');

  api('sources')
    .then((d) => {
      channels(d.channels, d.fallback);
      materials(d);
      const ex = document.querySelector('[data-example]');
      if (ex && d.botLink) ex.textContent = d.botLink + '?start=метка';
    })
    .catch((err) => fail(host, err));

  function channels(list, fallback) {
    if (!host) return;
    host.innerHTML = '';

    // Колонки идут по пути к деньгам: сначала откуда и что обещали,
    // потом сколько дошло. «Выбрал материал» не показывается — он есть
    // у всех и каналы не различает.
    const table = el('table', {},
      el('thead', {}, el('tr', {},
        el('th', { scope: 'col', text: 'Откуда приходит' }),
        el('th', { scope: 'col', text: 'Что получает и почему' }),
        el('th', { scope: 'col', class: 'num', text: 'Пришло' }),
        el('th', { scope: 'col', class: 'num', text: 'Открыли' }),
        el('th', { scope: 'col', class: 'num', text: 'До предложения' }),
        el('th', { scope: 'col', class: 'num', text: 'На эфире' }))));

    const body = el('tbody');
    for (const c of list) {
      const value = c.source === '' ? NO_VALUE : c.source;
      const active = slice.source === value;
      const cell = (n) => el('td', { class: 'num' },
        String(n), ' ', c.started ? el('span', { class: 'of', text: share(n, c.started) }) : null);

      body.append(el('tr', { class: active ? 'picked' : '' },
        el('td', {},
          // Сверху место человеческими словами, метка под ним: метку
          // читают глазами раз в месяц, а «где это стоит» — каждый раз.
          el('a', {
            class: 'row-link',
            href: href('people', slice, { source: active ? '' : value }),
            'aria-current': active ? 'true' : undefined,
            text: c.where || (c.source ? 'метка Reel' : sourceLabel('')),
          }),
          c.source ? el('div', {}, el('code', { class: 'muted', text: c.source })) : null,
          c.deepLink && c.source
            ? el('div', {}, el('a', { class: 'muted', style: 'font-size:.8rem', href: c.deepLink, text: 'открыть ссылку' }))
            : null),
        el('td', {},
          el('div', { text: c.title }),
          el('div', { class: 'muted', style: 'font-size:.8rem', text: c.why })),
        el('td', { class: 'num', text: c.started }),
        cell(c.opened), cell(c.offered), cell(c.waitlist)));
    }
    table.append(body);
    host.append(table);
    host.append(el('p', { class: 'lede' },
      'Клик по строке открывает пришедших оттуда списком. Доли считаются от пришедших с этого места. ',
      'Стартовый разбор — ', el('code', { text: fallback }),
      ': его получает каждый, для кого не выбран другой, включая незнакомые метки Reel.'));
  }

  function materials(d) {
    const box = document.querySelector('[data-materials]');
    if (!box) return;
    box.innerHTML = '';

    for (const m of d.materials) {
      box.append(el('div', { style: 'margin-bottom:18px' },
        el('div', {}, el('b', { text: m.title }), ' ', el('code', { class: 'muted', text: m.id })),
        el('p', { class: 'lede', style: 'margin:4px 0', text: m.pitch }),
        el('p', { class: 'lede', style: 'margin:4px 0', text: m.inside }),
        el('p', { class: 'lede', style: 'margin:4px 0' },
          'Кнопка: «', m.button, '» · ',
          el('a', { href: (d.siteBase ?? '') + m.path, text: m.path }))));
    }
  }
</script>
