# Скопировать в .env рядом и заполнить. .env остаётся только на машине:
# в репозиторий он не попадает никогда.

# Домен, на который смотрит A-запись VPS. На нём Caddy выпустит сертификат.
BOT_DOMAIN=bot.alexeymuzyka.com

# Сайт со статьями. Меняется, только если переезжает сам сайт.
SITE_BASE_URL=https://alexeymuzyka.com

# BotFather
TELEGRAM_BOT_TOKEN=

# Случайная строка, её Telegram будет присылать в заголовке запроса.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Канал, который бот считает. Бот должен быть в нём админом.
TELEGRAM_CHANNEL_URL=https://t.me/alexeymuzykablog

# База. Пароль тоже случайный: openssl rand -hex 24
POSTGRES_USER=funnel
POSTGRES_PASSWORD=
POSTGRES_DB=funnel

# Бэкапы
BACKUP_KEEP_DAYS=14
BACKUP_EVERY_SECONDS=86400
# Куда выкладывать копию наружу, в формате rclone: remote:bucket/path.
# Пусто — копии остаются на этой же машине и умрут вместе с ней.
BACKUP_REMOTE=

# Страница воронки на /admin. Пароль спрашивает Caddy.
# Хэш: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'пароль'
#
# ВАЖНО: в хэше есть символы $, а compose читает их как подстановку
# переменной и молча съедает кусок строки. Каждый $ надо удвоить:
#   было  $2a$14$WxokPAsZ...
#   стало $$2a$$14$$WxokPAsZ...
# Иначе /admin будет отдавать 401 на верный пароль. То же касается любого
# другого значения здесь, если в нём окажется $.
ADMIN_USER=lesha
ADMIN_PASSWORD_HASH=

# Кого не показывать на /admin: свои тестовые аккаунты, через запятую.
# Данные остаются в базе, это фильтр отчёта. На выборке в несколько
# человек один свой прогон сдвигает все проценты, и воронка врёт.
ADMIN_HIDDEN_TELEGRAM_IDS=577134700
