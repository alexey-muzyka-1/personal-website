# Сертификаты Caddy получает и продлевает сам. Требование не наше:
# Telegram шлёт webhook только по HTTPS, платёжка потом тоже.

{$BOT_DOMAIN} {
	encode zstd gzip

	# Наружу открыты только эти пути. Всё остальное отвечает 404 и не
	# доходит до бота: незачем светить то, чего нет.
	@public path /telegram/webhook /r/* /healthz
	handle @public {
		reverse_proxy bot:8080
	}

	# Страница воронки. Пароль спрашивается здесь, а не в боте: своя
	# авторизация ради одной страницы на чтение — лишний код, который
	# потом надо поддерживать и который умеет ошибаться.
	@admin path /admin
	handle @admin {
		basic_auth {
			{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
		}
		reverse_proxy bot:8080
	}

	handle {
		respond "not found" 404
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
