    <script is:inline>
      (function () {
        var source = document.getElementById('agent-prompt-source');
        var buttons = document.querySelectorAll('[data-copy-prompt]');
        var statuses = document.querySelectorAll('.copy-status');

        function setStatus(message) {
          statuses.forEach(function (node) { node.textContent = message; });
          window.setTimeout(function () {
            statuses.forEach(function (node) { node.textContent = ''; });
          }, 3200);
        }

        async function copyPrompt(button) {
          if (!source) return;
          var original = button.querySelector('strong')?.textContent || button.textContent;
          var copied = false;
          try {
            await navigator.clipboard.writeText(source.value);
            copied = true;
          } catch (error) {
            source.classList.remove('visually-hidden');
            source.select();
            try {
              copied = document.execCommand('copy');
            } catch (fallbackError) {
              copied = false;
            }
            source.classList.add('visually-hidden');
          }
          if (!copied) {
            setStatus('Браузер запретил копирование. Выделите текст в блоке промпта вручную.');
            document.querySelector('.prompt-box')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return;
          }
          if (button.querySelector('strong')) button.querySelector('strong').textContent = 'Скопировано';
          else button.textContent = 'Скопировано';
          setStatus('Промпт скопирован. Вставьте его в агент с доступом к вашим файлам.');
          window.setTimeout(function () {
            if (button.querySelector('strong')) button.querySelector('strong').textContent = original;
            else button.textContent = original;
          }, 2200);
        }

        buttons.forEach(function (button) {
          button.addEventListener('click', function () { copyPrompt(button); });
        });
      })();
    </script>
  </main>
</Base>

