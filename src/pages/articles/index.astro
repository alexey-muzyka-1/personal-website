---
import Base from '../../layouts/Base.astro';
import { pinnedArticles, restArticles } from '../../data/articles';
---

<Base
  title="Статьи — Лёша Музыка"
  description="Большие практические разборы систем, которые я собираю для работы и жизни."
>
  <header class="head article-list-head">
    <div class="head-text">
      <h1>Статьи</h1>
      <p class="hero-desc">Большие разборы систем, которые я сначала собираю для себя.</p>
    </div>
  </header>

  {pinnedArticles.length > 0 && (
    <section class="pinned" aria-label="Закреплённые статьи">
      <p class="block-label">Закреплённое</p>
      {pinnedArticles.map((a) => (
        <a class="pinned-card" href={a.href}>
          <h2>{a.title}</h2>
          <p>{a.what}</p>
          {a.stat && <p class="pinned-stat">{a.stat}</p>}
          <span class="go">Читать →</span>
        </a>
      ))}
    </section>
  )}

  <section class="article-list" aria-label="Остальные статьи">
    {pinnedArticles.length > 0 && <p class="block-label list-label">Остальные</p>}
    {restArticles.map((a) => (
      <a class="article-row" href={a.href}>
        <div class="article-date">{a.dateLabel}</div>
        <div>
          <h2>{a.title}</h2>
          <p>{a.what}</p>
        </div>
        <span aria-hidden="true">→</span>
      </a>
    ))}
  </section>
</Base>

<style>
  .article-list-head { padding-bottom: 26px; }

  /* Закреплённое — карточка, а не строка списка: это ручной выбор редакции,
     и он должен читаться иначе, чем лента по датам. */
  .pinned { margin-top: 28px; }
  .pinned-card {
    display: block;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 14px;
    color: inherit;
  }
  .pinned-card + .pinned-card { margin-top: 14px; }
  .pinned-card:hover { color: inherit; border-color: var(--accent); }
  .pinned-card:hover h2 { color: var(--accent); }
  .pinned-card h2 {
    margin: 0 0 10px;
    font-size: 1.45rem;
    line-height: 1.25;
    text-wrap: balance;
  }
  .pinned-card p { margin: 0 0 14px; color: var(--muted); }
  .pinned-stat {
    margin: 0 0 16px !important;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .pinned-card .go { font-size: 0.92rem; color: var(--accent); }

  .article-list { margin-top: 28px; }
  /* Список идёт сразу за карточкой — отбиваем его от неё. */
  .article-list .list-label { margin-top: 40px; }
  .article-row:first-of-type { border-top: 1px solid var(--line); }
  .article-row {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 22px;
    align-items: start;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  .article-row:hover { color: inherit; }
  .article-row:hover h2 { color: var(--accent); }
  .article-date {
    color: var(--muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    padding-top: 4px;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 1.2rem;
  }
  p {
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 600px) {
    .article-row {
      grid-template-columns: 1fr auto;
      gap: 8px 16px;
    }
    .article-date { grid-column: 1 / -1; }
  }
</style>
