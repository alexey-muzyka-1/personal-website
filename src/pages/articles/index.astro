---
import Base from '../../layouts/Base.astro';
import { pinnedArticles, restArticles } from '../../data/articles';
import { botHref, FUNNEL_SOURCE } from '../../data/funnel';

// Пока статей меньше семи, делить их на «закреплённое» и «остальные» —
// это таксономия дороже содержимого. Один список, закреплённое сверху.
const list = [...pinnedArticles, ...restArticles];
const toBot = botHref(FUNNEL_SOURCE.home);
---

<Base
  title="Статьи — Лёша Музыка"
  description="Большие практические разборы систем, которые я собираю для работы и жизни."
>
  <header class="head article-list-head">
    <div class="head-text">
      <h1>Статьи</h1>
      <p class="hero-desc">Большие разборы систем, которые я сначала собираю для себя.</p>
    </div>
  </header>

  <section class="article-list" aria-label="Все статьи">
    {list.map((a) => (
      <a class="article-row" href={a.href}>
        <div class="article-date">{a.dateLabel}</div>
        <div>
          <h2>{a.title}</h2>
          <p>{a.what}</p>
        </div>
        <span aria-hidden="true">→</span>
      </a>
    ))}
  </section>

  {toBot && (
    <aside class="list-cta" data-cta="articles-end">
      <div>
        <h2>Дальше — в Telegram</h2>
        <p>Бот спросит одно и отдаст тот разбор, который подойдёт.</p>
      </div>
      <a class="btn-open" href={toBot}>Забрать разборы ↗</a>
    </aside>
  )}
</Base>

<style>
  .article-list-head { padding-bottom: 8px; }
  .article-list { margin-top: 34px; }
  .article-row {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: 26px;
    align-items: start;
    padding: 30px 0;
    border-bottom: 1px solid var(--line);
  }
  .article-row:first-of-type { border-top: 1px solid var(--line); }
  .article-row:hover { color: inherit; }
  .article-row:hover h2 { color: var(--accent); }
  .article-date {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    padding-top: 6px;
  }
  h2 {
    margin: 0 0 8px;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  p { color: var(--muted); margin: 0; max-width: 62ch; }

  .list-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 56px;
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }
  .list-cta h2 { margin: 0 0 6px; }
  .list-cta p { margin: 0; }

  @media (max-width: 640px) {
    .article-row { grid-template-columns: 1fr auto; gap: 8px 16px; padding: 24px 0; }
    .article-date { grid-column: 1 / -1; }
    .list-cta { display: block; }
    .list-cta .btn-open { margin-top: 18px; }
  }
</style>
