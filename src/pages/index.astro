---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { homeTools } from '../data/tools';
import { articleRoutes } from '../data/articles';
import { botHref, FUNNEL_SOURCE } from '../data/funnel';
import { giveaways } from '../data/systems';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Канал заполняется в config.ts. Пока пусто — ведём в открытый чат
// и не показываем счётчик, чтобы цифра не относилась не к тому месту.
const tgHref = SITE.telegramChannel || SITE.telegram;
const tgIsChannel = Boolean(SITE.telegramChannel);
const tgCount = tgIsChannel && SITE.telegramSubscribers ? SITE.telegramSubscribers : 0;

// Бот, когда он есть, забирает главный выход в телеграм: он помнит, из
// какого места сайта пришёл человек, и сам предлагает следующий шаг.
// Чат остаётся в футере, гейта нет — всё на сайте открыто и без бота.
const botHome = botHref(FUNNEL_SOURCE.home);
const tgLabel = tgIsChannel ? 'Читать канал' : 'Зайти в чат';

// Разметка для поиска: кто я и что за приложение.
// Person — сущность сайта, SoftwareApplication — единственный публичный
// неподделываемый пруф, который у нас есть.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Лёша Музыка',
    alternateName: 'Alex Muzyka',
    url: 'https://alexeymuzyka.com',
    image: 'https://alexeymuzyka.com/me.jpg',
    jobTitle: 'Основатель Viralmaxing',
    description:
      'Строю AI-продукты. Выкладываю инструменты и разбираю системы, которыми это делаю.',
    sameAs: [SITE.telegram],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Viralmaxing',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'iOS, Web',
    url: 'https://viralmaxing.com',
    installUrl: SITE.viralmaxingAppStore,
    author: { '@type': 'Person', name: 'Лёша Музыка' },
  },
];
---

<Base
  description="Строю AI-продукты. Выкладываю инструменты и разбираю системы, которыми это делаю."
  schema={schema}
>
  <header class="head">
    <img class="portrait" src={`${base}me.jpg`} alt="Лёша Музыка" width="110" height="110" />
    <div class="head-text">
      <h1>Лёша Музыка</h1>
      <p class="hero-tagline">
        Строю AI-продукты. Выкладываю инструменты и разбираю системы, которыми это делаю.
      </p>
      <p class="status">
        <span class="dot" aria-hidden="true"></span>работает прямо сейчас · последний разбор 14.08.2026
      </p>
    </div>
  </header>

  <div class="hero-actions" data-cta="hero">
    <a class="btn-primary" href={botHome ?? tgHref}>
      {botHome ? 'Забрать разборы в Telegram' : tgLabel} →
    </a>
    <a class="btn-open" href={`${base}articles`}>Читать на сайте</a>
  </div>

  <section class="block section-major">
    <h2 class="section-h">Что почитать <span class="all"><a href={`${base}articles`}>все →</a></span></h2>
    <div class="routes">
      {articleRoutes.map((a) => (
        <a class="route" href={a.href}>
          <span class="route-who">{a.audience}</span>
          <h3>{a.title}</h3>
          <p>{a.audienceWhat}</p>
          <span class="go">Читать →</span>
        </a>
      ))}
    </div>
  </section>

  {homeTools.length > 0 && (
    <section class="block section-major">
      <h2 class="section-h">Инструменты <span class="all"><a href={`${base}tools`}>все →</a></span></h2>
      <p>
        Агенты и системы из моего рабочего контура. Ничего не собрано специально
        для этой страницы — всё уже крутится каждый день. Забирайте, взамен ничего
        не нужно.
      </p>
      <div class="grid">
        {homeTools.map((t) => (
          <a class="tile" href={t.href}>
            <div class="tile-ico"><Icon name={t.icon} /></div>
            <h3>{t.name}</h3>
            <p>{t.what}</p>
            <span class="go">{t.grab} →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="block section-major">
    <h2 class="section-h">Telegram</h2>
    <div class="tg" data-cta="home-telegram">
      <div class="tg-text">
        <p>
          Пишу про продукты, агентов и находки — то, что не помещается в статью
          и появляется раньше, чем инструмент доедет до этого сайта.
        </p>
        {botHome && (
          <p class="tg-note">Бот отдаёт разборы целиком и подсказывает, с чего начать.</p>
        )}
        {tgCount > 0 && <p class="tg-count">{tgCount} подписчиков</p>}
      </div>
      <a class="btn-open" href={botHome ?? tgHref}>
        {botHome ? 'Забрать разборы' : tgLabel} ↗
      </a>
    </div>
  </section>

  <section class="block section-major">
    <h2 class="section-h">Продукты</h2>
    <div class="prod-head">
      <img src={`${base}viralmaxing-logo.png`} alt="Viralmaxing" width="44" height="44" />
      <div>
        <h3>Viralmaxing</h3>
        <p>Главный фокус. Две части, каждая под свою работу.</p>
      </div>
    </div>
    <div class="grid">
      <a class="tile" href={SITE.viralmaxing}>
        <div class="tile-top"><Icon name="web" size={18} /><b>Веб</b></div>
        <p>Вся аналитика рилсов в одном экране.</p>
        <span class="go">viralmaxing.com →</span>
      </a>
      <a class="tile" href={SITE.viralmaxingAppStore}>
        <div class="tile-top"><Icon name="iphone" size={18} /><b>iPhone</b></div>
        <p>Быстро адаптируешь сценарий под себя и растишь свой аккаунт.</p>
        <span class="go">App Store →</span>
      </a>
    </div>
  </section>

  <section class="block section-major">
    <h2 class="section-h">Что можно забрать</h2>
    <p>
      Всё это работает у меня каждый день. Ничего не собрано специально для
      этой страницы, и взамен ничего не нужно.
    </p>
    <table class="systems">
      {giveaways.map((item) => (
        <tr>
          <td><a class="s-name" href={item.href}>{item.name}</a></td>
          <td class="s-kind">{item.kind}</td>
          <td class="s-what">{item.what}</td>
          <td class="s-state">забрать →</td>
        </tr>
      ))}
    </table>
  </section>

  <p class="more-line">
    Ещё здесь есть <a href={`${base}mantra`}>мантра</a>
    {', которую я перечитываю, и '}
    <a href={`${base}books`}>список книг</a>, которые на меня повлияли.
  </p>
</Base>

<style>
  /* Развилка: человек узнаёт себя в первой строке и идёт по своей
     ветке. Две колонки на десктопе, стопкой на телефоне. */
  .routes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
    margin-top: 4px;
  }
  .route {
    display: block;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    color: inherit;
  }
  .route:hover { color: inherit; border-color: var(--accent); }
  .route:hover h3 { color: var(--accent); }
  .route-who {
    display: block;
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .route h3 {
    margin: 0 0 10px;
    font-size: 1.28rem;
    line-height: 1.25;
    text-wrap: balance;
  }
  .route p { margin: 0 0 14px; color: var(--muted); font-size: 0.94rem; }
  .route .go { font-size: 0.92rem; color: var(--accent); }

  .tg {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 16px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .tg-text p { margin: 0; }
  .tg-note {
    margin-top: 8px !important;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .tg-count {
    margin-top: 6px !important;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .tg .btn-open { flex: 0 0 auto; }
  .more-line {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .more-line a { color: var(--accent); }
  .more-line a:hover { text-decoration: underline; }
  @media (max-width: 600px) {
    .feature { grid-template-columns: 1fr; gap: 16px; }
    /* Кроп дашборда занимал весь первый экран статьи и выталкивал
       заголовок за сгиб. Ограничиваем. */
    .feature-thumb { max-width: 200px; }
    .feature-thumb { width: 100%; }
    .tg { display: block; }
    .tg .btn-open { margin-top: 16px; }
  }
</style>
