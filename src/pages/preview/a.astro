---
// ВАРИАНТ А — «рабочий контур».
//
// Продаёт так: человек управляет компанией из терминала, и сайт выглядит
// как срез этого контура. Тёмная тема по умолчанию, моноширинный несущий,
// а не декоративный. Числа стоят в колонках, как в выводе команды.
//
// Это превью, оно не подключено к сайту и ничего на нём не меняет.
const nums = [
  ['просмотров за 30 дней', '49 700 000'],
  ['публикаций за 30 дней', '1 318'],
  ['аккаунтов в системе', '1 322'],
  ['разборов выложено', '3'],
];
const systems = [
  ['viralmaxing', 'продукт', 'веб и iPhone, аналитика рилсов', 'работает'],
  ['контент-агент', 'агент', 'собирает и публикует ролики', 'открыт'],
  ['health-vault', 'система', 'часы, заметки и агент в одном', 'открыт'],
  ['личная воронка', 'система', 'бот, метки источников, база', 'собрана'],
];
---

<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>А · рабочий контур</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  :root {
    --bg: #0e0f0d;
    --panel: #161815;
    --fg: #e8e6df;
    --muted: #8d8a80;
    --line: #262925;
    --live: #7fb069;
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --sans: 'Inter', -apple-system, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--sans); line-height: 1.6; }
  .wrap { max-width: 900px; margin: 0 auto; padding: 0 24px 80px; }

  .bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 0; font-family: var(--mono); font-size: .76rem;
    color: var(--muted); border-bottom: 1px solid var(--line);
  }
  .bar b { color: var(--fg); font-weight: 500; }
  .bar nav { display: flex; gap: 20px; }
  .bar a { color: var(--muted); text-decoration: none; }
  .bar a:hover { color: var(--fg); }

  .hero { padding: 56px 0 40px; }
  .who { font-family: var(--mono); font-size: .76rem; color: var(--muted); margin: 0 0 18px; }
  .who .dot {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: var(--live); margin-right: 8px; vertical-align: middle;
  }
  h1 { font-size: clamp(2.1rem, 6vw, 3.4rem); line-height: 1.05; margin: 0 0 20px; font-weight: 600; letter-spacing: -.02em; max-width: 16ch; }
  h1 em { font-style: normal; color: var(--muted); }
  .lede { font-size: 1.08rem; color: var(--muted); max-width: 46ch; margin: 0 0 32px; }

  .go { display: flex; flex-wrap: wrap; gap: 12px; }
  .go a {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px;
    border-radius: 8px; text-decoration: none; font-size: .95rem; font-weight: 500;
    font-family: var(--mono);
  }
  .go .primary { background: var(--fg); color: var(--bg); }
  .go .primary:hover { background: var(--live); }
  .go .ghost { border: 1px solid var(--line); color: var(--fg); }
  .go .ghost:hover { border-color: var(--muted); }

  /* Числа как вывод команды: подпись слева, значение справа, моноширина. */
  .nums { margin: 48px 0 0; border-top: 1px solid var(--line); }
  .nums div {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    padding: 13px 0; border-bottom: 1px solid var(--line);
    font-family: var(--mono); font-size: .82rem;
  }
  .nums span { color: var(--muted); }
  .nums b { font-weight: 500; font-size: 1rem; font-variant-numeric: tabular-nums; }

  .sec { margin: 64px 0 0; }
  .sec h2 { font-family: var(--mono); font-size: .76rem; font-weight: 400; color: var(--muted); text-transform: uppercase; letter-spacing: .12em; margin: 0 0 18px; }

  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  td { padding: 14px 16px 14px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  td:last-child { padding-right: 0; text-align: right; }
  .name { font-family: var(--mono); font-weight: 500; white-space: nowrap; }
  .kind { font-family: var(--mono); font-size: .74rem; color: var(--muted); }
  .what { color: var(--muted); }
  .state { font-family: var(--mono); font-size: .74rem; color: var(--live); white-space: nowrap; }

  @media (max-width: 640px) {
    .bar nav { display: none; }
    .what, .kind { display: none; }
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="bar">
    <b>лёша музыка</b>
    <nav><a href="#">статьи</a><a href="#">инструменты</a><a href="#">книги</a></nav>
  </div>

  <div class="hero">
    <p class="who"><span class="dot"></span>работает прямо сейчас · последний разбор 14.08</p>
    <h1>Строю AI-продукты <em>и показываю, как</em></h1>
    <p class="lede">
      Разбираю системы, которыми это делаю: контент на объёме, агенты, аналитика.
      Целиком и бесплатно, без подписки и почты.
    </p>
    <div class="go">
      <a class="primary" href="#">Забрать разборы →</a>
      <a class="ghost" href="#">Смотреть на сайте</a>
    </div>

    <div class="nums">
      {nums.map(([label, value]) => (
        <div><span>{label}</span><b>{value}</b></div>
      ))}
    </div>
  </div>

  <div class="sec">
    <h2>что крутится</h2>
    <table>
      {systems.map(([name, kind, what, state]) => (
        <tr>
          <td class="name">{name}</td>
          <td class="kind">{kind}</td>
          <td class="what">{what}</td>
          <td class="state">{state}</td>
        </tr>
      ))}
    </table>
  </div>
</div>
</body>
</html>
