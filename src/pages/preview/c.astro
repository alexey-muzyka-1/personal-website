---
// ВАРИАНТ В — «доказательство».
//
// Продаёт так: первым говорит не имя, а результат. Экран строится вокруг
// одного скриншота рабочей аналитики, имя стоит подписью под ним. Ближе
// всего к продуктовому лендингу, но пруф настоящий, а не обещание.
//
// Это превью, оно не подключено к сайту.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const proof = [
  ['49,7 млн', 'просмотров за 30 дней'],
  ['1318', 'публикаций за 30 дней'],
  ['1322', 'аккаунта в системе'],
];
---

<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>В · доказательство</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
  :root {
    --bg: #faf8f4;
    --fg: #171614;
    --muted: #66625a;
    --line: #e3ded3;
    --accent: #14563f;
    --mono: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font-family: 'Inter', -apple-system, sans-serif; line-height: 1.6; }
  .wrap { max-width: 1000px; margin: 0 auto; padding: 0 28px 90px; }

  .bar { display: flex; align-items: center; justify-content: space-between; padding: 22px 0; }
  .bar b { font-size: .95rem; font-weight: 600; }
  .bar nav { display: flex; gap: 22px; font-size: .86rem; }
  .bar a { color: var(--muted); text-decoration: none; }
  .bar a:hover { color: var(--fg); }

  .hero { padding: 40px 0 0; text-align: center; }
  .tag {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--mono); font-size: .72rem; letter-spacing: .06em;
    color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    padding: 6px 12px; border-radius: 999px; margin: 0 0 26px;
  }
  h1 {
    font-size: clamp(2.2rem, 5.6vw, 3.6rem); line-height: 1.06; font-weight: 700;
    letter-spacing: -.025em; margin: 0 auto 20px; max-width: 18ch; text-wrap: balance;
  }
  .sub { font-size: 1.1rem; color: var(--muted); max-width: 52ch; margin: 0 auto 30px; }
  .go { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin: 0 0 14px; }
  .go a { display: inline-flex; align-items: center; min-height: 50px; padding: 0 24px; border-radius: 10px; text-decoration: none; font-size: .96rem; font-weight: 500; }
  .go .primary { background: var(--accent); color: #fff; }
  .go .primary:hover { background: #0f4531; }
  .go .ghost { border: 1px solid var(--line); color: var(--fg); background: #fff; }
  .fine { font-size: .82rem; color: var(--muted); margin: 0 0 44px; }

  /* Пруф — не иллюстрация, а главный аргумент, поэтому он крупный. */
  .shotwrap { position: relative; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 12px 40px -12px rgba(0,0,0,.16); }
  .shotwrap img { width: 100%; display: block; }
  .caption { display: flex; align-items: center; gap: 12px; justify-content: center; margin: 18px 0 0; font-size: .86rem; color: var(--muted); }
  .caption img { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; }
  .caption a { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }

  .proof { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: 56px 0 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .proof div { padding: 26px 20px; text-align: center; border-left: 1px solid var(--line); }
  .proof div:first-child { border-left: 0; }
  .proof b { display: block; font-size: 1.9rem; font-weight: 600; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .proof span { font-size: .82rem; color: var(--muted); }

  @media (max-width: 720px) {
    .bar nav { display: none; }
    .proof { grid-template-columns: 1fr; }
    .proof div { border-left: 0; border-top: 1px solid var(--line); padding: 20px; }
    .proof div:first-child { border-top: 0; }
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="bar">
    <b>Лёша Музыка</b>
    <nav><a href="#">Статьи</a><a href="#">Инструменты</a><a href="#">Книги</a></nav>
  </div>

  <div class="hero">
    <span class="tag">это не кейс клиента, это наш экран</span>
    <h1>Вот система, которая собирает 50 млн просмотров в месяц</h1>
    <p class="sub">
      Я выкладываю её целиком: аватар, скрипт, продакшн и аналитика, по которой
      мы каждый день решаем, что дожимать.
    </p>
    <div class="go">
      <a class="primary" href="#">Забрать разбор в Telegram</a>
      <a class="ghost" href="#">Читать на сайте</a>
    </div>
    <p class="fine">Без подписки и без почты. Открыл и читаешь.</p>

    <div class="shotwrap">
      <img src={`${base}blueprint/analytics-overview.png`} alt="Дашборд аналитики: просмотры, публикации, подписчики" />
    </div>
    <p class="caption">
      <img src={`${base}me.jpg`} alt="" />
      Лёша Музыка, основатель <a href="#">Viralmaxing</a>
    </p>
  </div>

  <div class="proof">
    {proof.map(([value, label]) => (
      <div><b>{value}</b><span>{label}</span></div>
    ))}
  </div>
</div>
</body>
</html>
